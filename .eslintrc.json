{
  "env": {
    "browser": true,
    "es2021": true,
    "node": true,
    "jest": true
  },
  "extends": "eslint:recommended",
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "rules": {
    "indent": ["error", 4],
    "linebreak-style": ["error", "unix"],
    "quotes": ["error", "single", { "avoidEscape": true }],
    "semi": ["error", "always"],
    "no-unused-vars": ["warn"],
    "no-console": "off",
    "prefer-const": "warn",
    "no-var": "error"
  },
  "globals": {
    "WebSocket": "readonly",
    "RTCPeerConnection": "readonly",
    "RTCSessionDescription": "readonly",
    "RTCIceCandidate": "readonly",
    "WebRTCClient": "writable",
    "GraphVisualizer": "writable"
  }
}
