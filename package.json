{
  "name": "webrtc-graph-demo",
  "version": "1.0.0",
  "description": "WebRTC peer-to-peer graph demo with multiple topology scenarios",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "lint": "eslint . --ext .js",
    "lint:fix": "eslint . --ext .js --fix",
    "lint:html": "htmlhint public/*.html",
    "lint:css": "stylelint public/*.css",
    "test": "jest --coverage --testPathIgnorePatterns=/integration/",
    "test:watch": "jest --watch",
    "test:unit": "jest --testPathPattern=test/unit",
    "test:integration": "jest --testPathPattern=test/integration",
    "test:all": "jest --coverage",
    "validate": "npm run lint && npm run lint:html && npm run lint:css && npm test",
    "security:audit": "npm audit --audit-level=moderate",
    "security:check": "snyk test || true",
    "build": "echo 'Static files ready for deployment'",
    "pretest": "npm run lint"
  },
  "keywords": ["webrtc", "p2p", "peer-to-peer", "graph", "demo"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "ws": "^8.13.0"
  },
  "devDependencies": {
    "eslint": "^8.56.0",
    "htmlhint": "^1.1.4",
    "stylelint": "^16.1.0",
    "stylelint-config-standard": "^36.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "@testing-library/dom": "^9.3.4",
    "supertest": "^6.3.3"
  }
}
